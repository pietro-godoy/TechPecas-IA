# Configurações do Banco de Dados
DB_HOST=seu_host_mysql
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=techpecas
DB_PORT=3306
DB_SSL=true
DB_SSL_VERIFY=false
# DB_CA_PATH=ca.pem

# Google Generative AI
GOOGLE_API_KEY=sua_chave_da_api_google

# Porta da aplicação
PORT=3000

# Ambiente (development ou production)
NODE_ENV=production
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_RETRIES=2
GEMINI_RETRY_BASE_MS=1000


# Busca externa de preços (Google Shopping via SerpApi)
SERPAPI_KEY=sua_chave_serpapi


# Usuário autorizado como administrador
ADMIN_USERNAME=seu_usuario_admin


# Asaas Sandbox
ASAAS_ENV=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=sua_chave_sandbox
ASAAS_WEBHOOK_TOKEN=use_um_token_secreto_com_32_ou_mais_caracteres
ASAAS_WEBHOOK_EMAIL=seu_email_para_alertas
APP_PUBLIC_URL=https://techpecas-ia.onrender.com
